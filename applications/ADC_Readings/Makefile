######################################
# target
######################################
PLATFORM ?= stm32f4x
TARGET := ADC_Readings
PLATFORM_PATH := ../../bsp/$(PLATFORM)

######################################
# Programmer and compiler paths
######################################

# Call Makefile generated by CubeMX
include $(PLATFORM_PATH)/$(TARGET)/stm32.mk

#######################################
# Custom targets
#######################################
build_flash:
	make -j9 all && make upload

clean:
	-rm -fR $(BUILD_DIR)

compiledb:
	compiledb make -j9 all

upload:
	$(PROGRAMMER) --connect port=SWD mode=UR reset=HWrst -d ./build/$(TARGET).elf 0x08000000  --verify -g
monitor:
	pyserial-miniterm $(SERIAL_PORT) 112500
.DEFAULT_GOAL := build_flash

# *** EOF ***
